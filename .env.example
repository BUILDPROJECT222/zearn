# ---------- Solana ----------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# $ZEARN mint (set after the coin is created on pump.fun)
ZEARN_MINT=
TOKEN_DECIMALS=6
# Vault wallet: receives pump.fun creator fees. Secret key as base58 OR JSON array [1,2,...]
VAULT_SOL_SECRET=
# SOL kept in the wallet for gas
SOL_RESERVE=0.05
# Minimum SOL before a sweep to ZEC is triggered
MIN_SWEEP_SOL=0.1
SWEEP_INTERVAL_SEC=300
# EXPERIMENTAL: try to auto-claim bonding-curve creator fees (collect_creator_fee). Default: claim manually on pump.fun
AUTO_CLAIM_PUMP=false
# Optional ops/dev wallet receiving (100 - TREASURY_SHARE_PCT)% of fees. Empty = 100% to treasury
OPS_SOL_ADDRESS=
TREASURY_SHARE_PCT=90

# ---------- NEAR / Intents ----------
NEAR_NETWORK=mainnet
NEAR_RPC_URL=https://rpc.mainnet.near.org
# NEAR treasury account. The ZEC vault balance is held as nep141:zec.omft.near inside the intents.near contract
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=ed25519:...
ONECLICK_URL=https://1click.chaindefuser.com
# Optional. Without a JWT, 1Click charges a small fee
ONECLICK_JWT=
ASSET_SOL=nep141:sol.omft.near
ASSET_ZEC=nep141:zec.omft.near
ZEC_DECIMALS=8

# ---------- Protocol ----------
FLOOR_SPLIT_PCT=50
REDEEM_FEE_BPS=200
MIN_REDEEM_TOKENS=1000
MIN_CLAIM_ZEC=0.002
# Memo prefix users must include when burning
MEMO_PREFIX=ZEARN
VEST_CURVE=0.25:5, 0.5:10, 1:20, 2:35, 4:60, 6:80, 8:100
# Extra owners excluded from Hold Pool accrual (comma separated). PDAs are excluded automatically
EXCLUDE_OWNERS=

# ---------- Server ----------
PORT=8787
DB_PATH=./data/zearn.db
CORS_ORIGIN=http://localhost:5173
# true = never sends SOL, never pays redeems/claims; everything is recorded only. Disable only when ready to go live.
DRY_RUN=true

# ---------- Payout destinations (1Click asset ids) ----------
ASSET_ZEC_SOL=1cs_v1:sol:spl:A7bdiYdS5GjqGFtxf17ppRHtDKPkkRqbKtR27dxvQXaS
ASSET_NEAR=nep141:wrap.near
ASSET_USDC_SOL=nep141:sol-5ce3bf3a31af18be40ba30f721101b4341690186.omft.near
# Effective minimum claim = max(MIN_CLAIM_ZEC, MIN_CLAIM_USD at the current ZEC price)
MIN_CLAIM_USD=5

# ---------- Burn scanner ----------
BURN_SCAN_ENABLED=true
BURN_SCAN_INTERVAL_SEC=60
# Optional Helius webhook secret (Authorization header)
HELIUS_WEBHOOK_SECRET=
# Optional 1Click API key (removes the 20 bps default app fee)
ONECLICK_API_KEY=

# Unified (u1) Zcash payout addresses: keep false until one real u1 payout has been verified
ALLOW_UNIFIED_ZEC=false
